{
  "name": "admin-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app",
    "build:app": "tsc -b && vite build",
    "docs:check": "node scripts/docs-validate.mjs",
    "lint": "eslint .",
    "test": "vitest --exclude \"src/integration/**/*.integration.test.{ts,tsx}\"",
    "test:ci": "vitest --run --coverage --exclude \"src/integration/**/*.integration.test.{ts,tsx}\" --maxWorkers=1 --no-file-parallelism",
    "test:integration": "vitest --config vitest.integration.config.ts --run --maxWorkers=1 --fileParallelism=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "baseline-browser-mapping": "2.11.22",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "nanoid": "3.3.19",
    "undici": "7.29.1"
  }
}
